{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gschmidtke/USG/schema/curation-record.schema.json",
  "title": "USG Curation Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "source_submission",
    "reviewed_at",
    "reviewed_by",
    "status",
    "classification",
    "summary",
    "decision",
    "rationale"
  ],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "source_submission": {"type": "string", "pattern": "^inbox/"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reviewed_by": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": ["triaged", "normalized", "testing", "proposed", "accepted", "held", "rejected", "superseded"]
    },
    "classification": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "protocol_rule",
          "stage_or_gate",
          "schema",
          "evidence_or_authority",
          "feedback_loop",
          "conformance_case",
          "failure_pattern",
          "worked_example",
          "documentation",
          "proposal",
          "duplicate",
          "non_generalizable"
        ]
      }
    },
    "summary": {"type": "string", "minLength": 1},
    "affected_areas": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "decision": {
      "type": "string",
      "enum": [
        "accept_as_example",
        "accept_as_test",
        "accept_as_documentation",
        "promote_to_patch_candidate",
        "hold_for_evidence",
        "reject",
        "duplicate",
        "supersede"
      ]
    },
    "rationale": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "tests_performed": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "resulting_files": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "resulting_protocol_version": {"type": ["string", "null"]},
    "requires_owner_approval": {"type": "boolean", "default": false},
    "owner_approval": {
      "type": ["object", "null"],
      "properties": {
        "approved": {"type": "boolean"},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "approved_by": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      },
      "required": ["approved"],
      "additionalProperties": false
    },
    "unresolved_questions": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    }
  }
}
