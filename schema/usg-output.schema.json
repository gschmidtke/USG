{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gschmidtke/USG/schema/usg-output.schema.json",
  "title": "USG Output",
  "type": "object",
  "required": [
    "schema_version",
    "entry_stage",
    "resolved_stages",
    "purpose",
    "assumptions",
    "ambiguities",
    "acceptance_invariants",
    "handoff_stage",
    "handoff_payload"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "parent_frame_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "entry_stage": {
      "type": "string",
      "pattern": "^S(0[0-9]|1[0-9]|20)$",
      "description": "Protocol stage id S00-S20 (see protocol/CURRENT)."
    },
    "resolved_stages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^S(0[0-9]|1[0-9]|20)$",
        "description": "Protocol stage id S00-S20 (see protocol/CURRENT)."
      },
      "uniqueItems": true
    },
    "purpose": {
      "type": [
        "object",
        "string"
      ]
    },
    "constraints": {
      "type": "array",
      "items": {}
    },
    "assumptions": {
      "type": "array",
      "items": {}
    },
    "ambiguities": {
      "type": "array",
      "items": {}
    },
    "acceptance_invariants": {
      "type": "array",
      "items": {}
    },
    "required_resolution": {
      "type": [
        "string",
        "object",
        "null"
      ]
    },
    "handoff_stage": {
      "type": "string",
      "pattern": "^S(0[0-9]|1[0-9]|20)$",
      "description": "First protocol stage the downstream system (e.g. ARPL) is expected to carry out, S00-S20."
    },
    "handoff_payload": {
      "type": "object"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_kind"
        ],
        "properties": {
          "source_kind": {
            "enum": [
              "exact",
              "derived",
              "approximate",
              "user_accepted",
              "observed",
              "ambiguous",
              "unknown",
              "convention"
            ],
            "description": "Source class; mapped to canonical authority and gate behaviour by evidence_model.source_class_mapping (protocol v0.13)."
          },
          "value": {},
          "source": {},
          "confidence": {
            "oneOf": [
              {
                "enum": [
                  "high",
                  "medium",
                  "low"
                ]
              },
              {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              {
                "type": "null"
              }
            ],
            "description": "Canonical high | medium | low. A number is allowed only with evidence_model.confidence_conversion: >= 0.8 high, >= 0.5 medium, below 0.5 low."
          },
          "authority": {
            "enum": [
              "human",
              "domain_library",
              "ai_generated",
              "derived",
              "professional_review",
              "external_evidence",
              null
            ],
            "description": "Canonical authority (answer_authority.authorities)."
          },
          "origin": {
            "type": [
              "string",
              "null"
            ],
            "description": "Authority that proposed the value when it differs from the deciding one (user_accepted: ai_generated)."
          },
          "accepted_on": {
            "type": [
              "string",
              "null"
            ],
            "description": "ISO date the human designer accepted an AI estimate (user_accepted)."
          }
        },
        "additionalProperties": true
      }
    },
    "handoff": {
      "type": "object",
      "description": "Source-neutral hand-off record (protocol v0.13 schemas.handoff, export_model.handoff_rule). A target may change representation, never evidence state or intent.",
      "properties": {
        "target": {
          "type": "string"
        },
        "descent_premises": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "premise"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "premise": {
                "type": "string"
              },
              "owning_decision_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "build_policy": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item_ref",
              "policy"
            ],
            "properties": {
              "item_ref": {
                "type": "string"
              },
              "policy": {
                "enum": [
                  "build",
                  "record_only",
                  "ignore"
                ]
              }
            }
          }
        },
        "approximate_policy": {
          "enum": [
            "excluded",
            "labeled"
          ]
        },
        "pending_user": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item_ref"
            ],
            "properties": {
              "item_ref": {
                "type": "string"
              },
              "question_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "acceptance_invariants": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "statement"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "statement": {
                "type": "string"
              },
              "readback_check": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "result": {
                "enum": [
                  "pass",
                  "fail",
                  "not_evaluable",
                  null
                ]
              }
            }
          }
        },
        "specified_products": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "item_ref",
              "product",
              "authority"
            ],
            "properties": {
              "item_ref": {
                "type": "string"
              },
              "product": {
                "type": "string"
              },
              "basis_of_design": {
                "type": "boolean"
              },
              "authority": {
                "type": "string"
              },
              "source_ref": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "description": "A specified product (basis of design with its authority), never a requirement."
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
